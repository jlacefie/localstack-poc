# LocalStack environment — use for local development
# Usage: source .env.localstack

export AWS_ENDPOINT_URL=http://localhost:4566
export AWS_DEFAULT_REGION=us-east-1
export AWS_ACCESS_KEY_ID=test
export AWS_SECRET_ACCESS_KEY=test

# LocalStack uses a fixed fake account ID; any value works for the role ARN
export LAMBDA_ROLE_ARN=arn:aws:iam::000000000000:role/lambda-role
